<mvc:View
    controllerName="mm.poupload.controller.Main"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:t="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
>
    <Page
        showHeader="false"
        showFooter="false"
    >
        <content>
            <IconTabBar
                id="idIconTabBar"
                expanded="{device>/isNoPhone}"
                stretchContentHeight="true"
                backgroundDesign="Transparent"
                applyContentPadding="false"
                class="sapUiResponsiveContentPadding"
            >
                <items>
                    <IconTabFilter
                        text="{i18n>Upload}"
                        key="view5"
                    >
                        <mvc:XMLView
                            viewName="mm.poupload.view.Upload"
                            height="100%"
                        />
                    </IconTabFilter>
                    <IconTabFilter
                        text="{i18n>Report}"
                        key="view6"
                    >
                        <mvc:XMLView
                            viewName="mm.poupload.view.Report"
                            height="100%"
                        />
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
