{
  "_version": "1.60.0",
  "sap.app": {
    "id": "pp.zofsplitrule",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.18.7",
      "toolsId": "a52ee324-ea63-429f-880a-0ac0edff3aa7"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_ofsplitrule_o4/srvd/sap/zui_ofsplitrule_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      },
      "API_CV_ATTACHMENT_SRV": {
        "uri": "/sap/opu/odata/sap/API_CV_ATTACHMENT_SRV/",
        "type": "OData",
        "settings": {
          "localUri": "localService/S4/API_CV_ATTACHMENT_SRV/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "oflist-display": {
          "semanticObject": "oflist",
          "action": "display",
          "icon": "sap-icon://table-chart",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.18",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pp.zofsplitrule.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "local": {
        "type": "sap.ui.model.json.JSONModel",
        "preload": true
      },
      "Attach": {
        "dataSource": "API_CV_ATTACHMENT_SRV",
        "preload": true,
        "settings": {
          "defaultCountMode": "Inline"
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SplitRuleList",
          "target": "SplitRuleList"
        },
        {
          "pattern": "SplitRule({key}):?query:",
          "name": "SplitRuleObjectPage",
          "target": "SplitRuleObjectPage"
        }
      ],
      "targets": {
        "SplitRuleList": {
          "type": "Component",
          "id": "SplitRuleList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/SplitRule",
              "variantManagement": "Page",
              "navigation": {
                "SplitRule": {
                  "detail": {
                    "route": "SplitRuleObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable"
                  },
                  "actions": {
                    "upload": {
                      "press": "pp.zofsplitrule.ext.controller.ListReportExt.openUploadDialog",
                      "visible": true,
                      "enabled": "{local>/authorityCheck/button/Upload}",
                      "requiresSelection": false,
                      "text": "{@i18n>upload}",
                      "icon": "sap-icon://upload-to-cloud"
                    }
                  }
                }
              }
            }
          }
        },
        "SplitRuleObjectPage": {
          "type": "Component",
          "id": "SplitRuleObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/SplitRule"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "pp01"
  },
  "sap.platform.cf": {
    "ui5VersionNumber": "1.120.18"
  }
}
