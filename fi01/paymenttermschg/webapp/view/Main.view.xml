<mvc:View
    controllerName="fi01.paymenttermschg.controller.Main"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage
        id="idDynamicPage"
        showFooter="false"
    >
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSVM"
                        showShare="true"
                        persistencyKey="PaymentTermsChgSVM"
                        showExecuteOnSelection="true"
                        entitySet="PaymentTermsChg"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idPaymentTermsSmartFilterBar"
                        smartVariant="idSVM"
                        persistencyKey="PaymentTermsChgSFB"
                        entitySet="PaymentTermsChg"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                        search="onSearch"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="CompanyCode"
                                visibleInAdvancedArea="true"
                                label="{/#PaymentTermsChgType/CompanyCode/@sap:label}"
                                mandatory="mandatory"
                                filterType="multiple"
                                index="5"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="PostingDate"
                                visibleInAdvancedArea="true"
                                label="{/#PaymentTermsChgType/PostingDate/@sap:label}"
                                mandatory="mandatory"
                                filterType="multiple"
                                index="10"
                            >
                                <smartFilterBar:customControl>
                                    <DateRangeSelection
                                        id="idDRPostingDate"
                                        valueFormat="yyyy/MM/dd"
                                        displayFormat="yyyy/MM/dd"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="Supplier"
                                visibleInAdvancedArea="true"
                                label="{/#PaymentTermsChgType/Supplier/@sap:label}"
                                filterType="multiple"
                                index="15"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="PaymentMethod"
                                visibleInAdvancedArea="true"
                                label="{/#PaymentTermsChgType/PaymentMethod/@sap:label}"
                                filterType="multiple"
                                index="20"
                            />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable
                id="idSmartTable"
                entitySet="PaymentTermsChg"
                smartFilterId="idPaymentTermsSmartFilterBar"
                smartVariant="idSVM"
                persistencyKey="PaymentTermsChgST"
                requestAtLeastFields="CompanyCode,AccountingDocument,FiscalYear,AccountingDocumentItem"
                ignoredFields="PostingDate,PaymentMethod"
                header="{i18n>title}"
                placeToolbarInTable="true"
                beforeExport="onBeforeExport"
                beforeRebindTable="onBeforeRebindTable"
            >
                <smartTable:customToolbar>
                    <OverflowToolbar id="idToolbar">
                        <ToolbarSpacer id="idToolbarSpacer" />
                        <Button
                            id="idBtnExcute"
                            type="Transparent"
                            text="{i18n>BtnExcute}"
                            press="onExecute"
                        />
                        <Button
                            id="idBtnJobExcute"
                            type="Transparent"
                            text="{i18n>BtnJobExcute}"
                            press="onJobExecute"
                        />
                    </OverflowToolbar>
                </smartTable:customToolbar>
                <t:Table
                    id="idTable"
                    selectionMode="Multi"
                    class="sapUiSizeCompact"
                >
                    <t:rowMode>
                        <rm:Auto id="idAuto" />
                    </t:rowMode>
                    <t:columns>
                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/Status/@sap:label}"
                            sortProperty="Status"
                            filterProperty="Status"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Status", "leadingProperty":"Status", "sortProperty":"Status", "filterProperty": "Status"}'
                                />
                            </t:customData>
                            <t:template>
                                <ObjectStatus state="{path:'Status', formatter:'.formatter.setState'}" icon="{path:'Status', formatter:'.formatter.setStateIcon'}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/Message/@sap:label}"
                            sortProperty="Message"
                            filterProperty="Message"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Message", "leadingProperty":"Message", "sortProperty":"Message", "filterProperty": "Message"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Message}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/CompanyCode/@sap:label}"
                            sortProperty="CompanyCode"
                            filterProperty="CompanyCode"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"CompanyCode", "leadingProperty":"CompanyCode", "sortProperty":"CompanyCode", "filterProperty": "CompanyCode"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{CompanyCode}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/Supplier/@sap:label}"
                            sortProperty="Supplier"
                            filterProperty="Supplier"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Supplier", "leadingProperty":"Supplier", "sortProperty":"Supplier", "filterProperty": "Supplier"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Supplier}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/SupplierName/@sap:label}"
                            sortProperty="SupplierName"
                            filterProperty="SupplierName"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"SupplierName", "leadingProperty":"SupplierName", "sortProperty":"SupplierName", "filterProperty": "SupplierName"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{SupplierName}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/AmountInCompanyCodeCurrency/@sap:label}"
                            sortProperty="AmountInCompanyCodeCurrency"
                            filterProperty="AmountInCompanyCodeCurrency"
                            hAlign="Right"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"AmountInCompanyCodeCurrency", "leadingProperty":"AmountInCompanyCodeCurrency", "sortProperty":"AmountInCompanyCodeCurrency", "filterProperty": "AmountInCompanyCodeCurrency"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'AmountInCompanyCodeCurrency',type:'sap.ui.model.odata.type.Decimal',formatOptions:{groupingEnabled:true}}"
                                    tooltip="{AmountInCompanyCodeCurrency}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/Counts/@sap:label}"
                            sortProperty="Counts"
                            filterProperty="Counts"
                            hAlign="Right"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Counts", "leadingProperty":"Counts", "sortProperty":"Counts", "filterProperty": "Counts"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Counts}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/LastDate/@sap:label}"
                            sortProperty="LastDate"
                            filterProperty="LastDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"LastDate", "leadingProperty":"LastDate", "sortProperty":"LastDate", "filterProperty": "LastDate"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{path:'LastDate', type:'sap.ui.model.type.Date', formatOptions:{UTC: true, pattern:'yyyy/MM/dd'}}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/DueDateChgBefore/@sap:label}"
                            sortProperty="DueDateChgBefore"
                            filterProperty="DueDateChgBefore"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DueDateChgBefore", "leadingProperty":"DueDateChgBefore", "sortProperty":"DueDateChgBefore", "filterProperty": "DueDateChgBefore"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{path:'DueDateChgBefore', type:'sap.ui.model.type.Date', formatOptions:{UTC: true, pattern:'yyyy/MM/dd'}}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/PaymentMethodChgBefore/@sap:label}"
                            sortProperty="PaymentMethodChgBefore"
                            filterProperty="PaymentMethodChgBefore"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PaymentMethodChgBefore", "leadingProperty":"PaymentMethodChgBefore", "sortProperty":"PaymentMethodChgBefore", "filterProperty": "PaymentMethodChgBefore"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{PaymentMethodChgBefore}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/PaymentTermsChgBefore/@sap:label}"
                            sortProperty="PaymentTermsChgBefore"
                            filterProperty="PaymentTermsChgBefore"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PaymentTermsChgBefore", "leadingProperty":"PaymentTermsChgBefore", "sortProperty":"PaymentTermsChgBefore", "filterProperty": "PaymentTermsChgBefore"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{PaymentTermsChgBefore}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/DueDateChgAfter/@sap:label}"
                            sortProperty="DueDateChgAfter"
                            filterProperty="DueDateChgAfter"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DueDateChgAfter", "leadingProperty":"DueDateChgAfter", "sortProperty":"DueDateChgAfter", "filterProperty": "DueDateChgAfter"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{path:'DueDateChgAfter', type:'sap.ui.model.type.Date', formatOptions:{UTC: true, pattern:'yyyy/MM/dd'}}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/PaymentMethodChgAfter/@sap:label}"
                            sortProperty="PaymentMethodChgAfter"
                            filterProperty="PaymentMethodChgAfter"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PaymentMethodChgAfter", "leadingProperty":"PaymentMethodChgAfter", "sortProperty":"PaymentMethodChgAfter", "filterProperty": "PaymentMethodChgAfter"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{PaymentMethodChgAfter}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/PaymentTermsChgAfter/@sap:label}"
                            sortProperty="PaymentTermsChgAfter"
                            filterProperty="PaymentTermsChgAfter"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PaymentTermsChgAfter", "leadingProperty":"PaymentTermsChgAfter", "sortProperty":"PaymentTermsChgAfter", "filterProperty": "PaymentTermsChgAfter"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{PaymentTermsChgAfter}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="9rem"
                            label="{/#PaymentTermsChgType/AccountingClerkFaxNumber/@sap:label}"
                            sortProperty="AccountingClerkFaxNumber"
                            filterProperty="AccountingClerkFaxNumber"
                            hAlign="Right"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"AccountingClerkFaxNumber", "leadingProperty":"AccountingClerkFaxNumber", "sortProperty":"AccountingClerkFaxNumber", "filterProperty": "AccountingClerkFaxNumber"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'AccountingClerkFaxNumber',type:'sap.ui.model.odata.type.Decimal',formatOptions:{groupingEnabled:true}}"
                                    tooltip="{AccountingClerkFaxNumber}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>
