<mvc:View controllerName="mm.poupload.controller.Upload"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:table="sap.ui.table">
    <Page >
        <content>
            <Panel expandable="true" expanded="false" headerText="{i18n>templateText}" width="auto">
                <upload:UploadSet id="idTemplateCollection" items="{ path : 'Attach>/Configuration' }" multiple="true" uploadEnabled="false" uploadButtonInvisible="true" instantUpload="false">
                    <upload:items>
                        <upload:UploadSetItem fileName="{Attach>TemplateName}" mediaType="{Attach>TemplateMimeType}" url="{Attach>TemplateContent}" visibleEdit="false" visibleRemove="false"/>
                    </upload:items>
                </upload:UploadSet>
            </Panel>
            <Panel id="idFileUploadPanel" expandable="true" expanded="true" headerText="{i18n>uploadText}" width="auto">
                <unified:FileUploader id="idFileUploader" fileType="xlsx,xls" change="onFileChange" width="40%" class="sapUiSmallMargin"/>
            </Panel>
            <Panel expandable="true" expanded="true" headerText="{i18n>result}" width="auto">
                <table:Table rows="{local>/excelSet}" selectionMode="Multi" fixedColumnCount="2" rowMode="Interactive" class="sapUiSizeCompact">
                    <table:extension>
                        <OverflowToolbar>
                            <Text text="{local>/logInfo}"/>
                            <ToolbarSpacer/>
                            <Button id="idClearButton" icon="sap-icon://clear-all" type="Transparent" text="{i18n>clearBtn}" press="onClear" visible="{= ${local>/excelSet}.length > 0}" enabled="true"/>
                            <Button id="idCheckButton" icon="sap-icon://check-availability" type="Transparent" text="{i18n>checkBtn}" press="onCheck" visible="{= ${local>/excelSet}.length > 0}" enabled="true"/>
                            <Button id="idExcuteButton" icon="sap-icon://document" type="Transparent" text="{i18n>excuteBtn}" press="onExcute" visible="{= ${local>/excelSet}.length > 0}" enabled="true"/>
                            <Button id="idExportButton" icon="sap-icon://excel-attachment" type="Transparent" text="{i18n>exportBtn}" press="onExport" visible="{= ${local>/excelSet}.length > 0}" enabled="true"/>
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column autoResizable="true" width="6rem" label="{i18n>Status}">
                            <table:template>
                                <ObjectStatus state="{ path:'local>Status',formatter:'.formatter.formatState' }" icon="{ path:'local>Status', formatter:'.formatter.formatStateIcon'}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="15rem" label="{i18n>Message}">
                            <table:template>
                                <Text text="{local>Message}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <!-- HEADNO 列 -->
                        <table:Column width="10rem" label="{i18n>HEADNO}">
                            <table:template>
                                <Text text="{local>HEADNO}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- DOCUMENTTYPE 列 -->
                        <table:Column width="10rem" label="{i18n>DOCUMENTTYPE}">
                            <table:template>
                                <Text text="{local>DOCUMENTTYPE}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- SUPPLIER 列 -->
                        <table:Column width="10rem" label="{i18n>SUPPLIER}">
                            <table:template>
                                <Text text="{local>SUPPLIER}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- COMPANYCODE 列 -->
                        <table:Column width="10rem" label="{i18n>COMPANYCODE}">
                            <table:template>
                                <Text text="{local>COMPANYCODE}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- PURCHASEORGANIZATION 列 -->
                        <table:Column width="10rem" label="{i18n>PURCHASEORGANIZATION}">
                            <table:template>
                                <Text text="{local>PURCHASEORGANIZATION}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- PURCHASEGROUP 列 -->
                        <table:Column width="10rem" label="{i18n>PURCHASEGROUP}">
                            <table:template>
                                <Text text="{local>PURCHASEGROUP}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- SUPPLYINGPLANT 列 -->
                        <table:Column width="10rem" label="{i18n>SUPPLYINGPLANT}">
                            <table:template>
                                <Text text="{local>SUPPLYINGPLANT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- DOCUMENTCURRENCY 列 -->
                        <table:Column width="10rem" label="{i18n>DOCUMENTCURRENCY}">
                            <table:template>
                                <Text text="{local>DOCUMENTCURRENCY}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- ITEMNO 列 -->
                        <table:Column width="10rem" label="{i18n>ITEMNO}">
                            <table:template>
                                <Text text="{local>ITEMNO}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- CATEGORY 列 -->
                        <table:Column width="10rem" label="{i18n>CATEGORY}">
                            <table:template>
                                <Text text="{local>CATEGORY}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- ITEMCATEGORY 列 -->
                        <table:Column width="10rem" label="{i18n>ITEMCATEGORY}">
                            <table:template>
                                <Text text="{local>ITEMCATEGORY}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- MATERIAL 列 -->
                        <table:Column width="10rem" label="{i18n>MATERIAL}">
                            <table:template>
                                <Text text="{local>MATERIAL}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- MATERIALTEXT 列 -->
                        <table:Column width="10rem" label="{i18n>MATERIALTEXT}">
                            <table:template>
                                <Text text="{local>MATERIALTEXT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- MATERIALGROUP 列 -->
                        <table:Column width="10rem" label="{i18n>MATERIALGROUP}">
                            <table:template>
                                <Text text="{local>MATERIALGROUP}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- PLANT 列 -->
                        <table:Column width="10rem" label="{i18n>PLANT}">
                            <table:template>
                                <Text text="{local>PLANT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- STORAGELOCATION 列 -->
                        <table:Column width="10rem" label="{i18n>STORAGELOCATION}">
                            <table:template>
                                <Text text="{local>STORAGELOCATION}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- DELIVERYDATE 列 -->
                        <table:Column width="10rem" label="{i18n>DELIVERYDATE}">
                            <table:template>
                                <Text text="{local>DELIVERYDATE}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- ORDERQUANTITY 列 -->
                        <table:Column width="10rem" label="{i18n>ORDERQUANTITY}">
                            <table:template>
                                <Text text="{local>ORDERQUANTITY}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- ORDERQUANTITY 列 -->
                        <table:Column width="10rem" label="{i18n>ORDERQUANTITYUNIT}">
                            <table:template>
                                <Text text="{local>ORDERQUANTITYUNIT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- RETURNFLAG 列 -->
                        <table:Column width="10rem" label="{i18n>RETURNFLAG}">
                            <table:template>
                                <Text text="{local>RETURNFLAG}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- TAXCODE 列 -->
                        <table:Column width="10rem" label="{i18n>TAXCODE}">
                            <table:template>
                                <Text text="{local>TAXCODE}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- NETPRICEAMOUNT 列 -->
                        <table:Column width="10rem" label="{i18n>NETPRICEAMOUNT}">
                            <table:template>
                                <Text text="{local>NETPRICEAMOUNT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- NETPRICEQUANTITY 列 -->
                        <table:Column width="10rem" label="{i18n>NETPRICEQUANTITY}">
                            <table:template>
                                <Text text="{local>NETPRICEQUANTITY}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- ORDERPRICEUNIT 列 -->
                        <table:Column width="10rem" label="{i18n>ORDERPRICEUNIT}">
                            <table:template>
                                <Text text="{local>ORDERPRICEUNIT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- WBSELEMENT 列 -->
                        <table:Column width="10rem" label="{i18n>WBSELEMENT}">
                            <table:template>
                                <Text text="{local>WBSELEMENT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- ACCOUNT 列 -->
                        <table:Column width="10rem" label="{i18n>ACCOUNT}">
                            <table:template>
                                <Text text="{local>ACCOUNT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- S4CODUMENT 列 -->
                        <table:Column width="10rem" label="{i18n>S4CODUMENT}">
                            <table:template>
                                <Text text="{local>S4CODUMENT}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- S4DOCUMENTITEM 列 -->
                        <table:Column width="10rem" label="{i18n>S4DOCUMENTITEM}">
                            <table:template>
                                <Text text="{local>S4DOCUMENTITEM}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <!-- REQUESTPAYLOAD 列 -->
                        <table:Column width="10rem" label="{i18n>REQUESTPAYLOAD}">
                            <table:template>
                                <Text text="{local>REQUESTPAYLOAD}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
