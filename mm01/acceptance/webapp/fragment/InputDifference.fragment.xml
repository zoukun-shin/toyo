<c:FragmentDefinition
    xmlns="sap.m"
    xmlns:c="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
    <Dialog
        id="idDialog"
        title="{i18n>DialogTitle}"
        contentWidth="65%"
        contentHeight="60%"
        draggable="true"
    >
        <smartForm:SmartForm
            id="idSmartForm"
            title="{Name}"
            validationMode="Async"
            editable="true"
            app:defaultCheckBoxDisplayBehaviour="YesNo"
            app:defaultDropDownDisplayBehaviour="idAndDescription"
            editTogglable="true"
            editToggled="onSmartFormEditToggled"
        >
            <smartForm:layout>
                <smartForm:Layout columnsM="2" columnsL="2" columnsXL="2" singleGroupFullSize="false"/>
            </smartForm:layout>

            <smartForm:Group id="idGroup">
                <!-- <smartForm:layoutData>
                    <l:GridData span="L6 M6 S6" />
                </smartForm:layoutData> -->
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/OrderNumber/@sap:label}"
                        value="{OrderNumber}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/RecordSequence/@sap:label}"
                        value="{RecordSequence}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/Material/@sap:label}"
                        value="{Material}"
                        change="onChangeMaterial"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                    textLabel="{/#PriceDifferenceType/MaterialName/@sap:label}"
                    value="{MaterialName}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                    textLabel="{/#PriceDifferenceType/Plant/@sap:label}"
                    value="{Plant}"
                    change="onChangePrice"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                    textLabel="{/#PriceDifferenceType/Supplier/@sap:label}"
                    value="{Supplier}"
                    change="onChangePrice"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                    textLabel="{/#PriceDifferenceType/SupplierName/@sap:label}"
                    value="{SupplierName}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/Abr/@sap:label}"
                        value="{Abr}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/PaySbu/@sap:label}"
                        value="{PaySbu}"
                    />
                </smartForm:GroupElement>
            </smartForm:Group>
            <smartForm:Group id="idGroup1">
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/TransCode/@sap:label}"
                        value="{TransCode}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/DisclosureDivision/@sap:label}"
                        value="{DisclosureDivision}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/InvoiceDate/@sap:label}"
                        value="{InvoiceDate}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/Unit/@sap:label}"
                        value="{Unit}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/Currency/@sap:label}"
                        value="{Currency}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/Quantity/@sap:label}"
                        value="{Quantity}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/PriceDiff/@sap:label}"
                        value="{PriceDiff}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/Amount/@sap:label}"
                        value="{Amount}"
                    />
                </smartForm:GroupElement>
                
            </smartForm:Group>
            <smartForm:Group>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/ErrorText/@sap:label}"
                        value="{ErrorText}"
                    />
                </smartForm:GroupElement>
            </smartForm:Group>
            <smartForm:Group>
                <smartForm:layoutData>
                    <l:GridData linebreak="true" />
                </smartForm:layoutData>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/CreatedBy/@sap:label}"
                        value="{CreatedBy}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/CreatedAt/@sap:label}"
                        value="{CreatedAt}"
                    />
                </smartForm:GroupElement>
            </smartForm:Group>
            <smartForm:Group>
                <smartForm:layoutData>
                    <l:GridData linebreak="false" />
                </smartForm:layoutData>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/LastChangedBy/@sap:label}"
                        value="{LastChangedBy}"
                    />
                </smartForm:GroupElement>
                <smartForm:GroupElement>
                    <smartField:SmartField
                        textLabel="{/#PriceDifferenceType/LastChangedAt/@sap:label}"
                        value="{LastChangedAt}"
                    />
                </smartForm:GroupElement>
            </smartForm:Group>
        </smartForm:SmartForm>
        <footer>
            <OverflowToolbar
                id="id1OverflowToolbar"
            >
                <Button
                    icon="sap-icon://alert"
                    text="{= ${message>/}.length }"
                    visible="{= ${message>/}.length > 0}"
                    type="Emphasized"
                    press="onMessagePopoverPress"
                />
                <ToolbarSpacer />
                <Button text="{i18n>bConfirm}" press="onDialogConfirm"/>
                <Button text="{i18n>bCancel}" press="onDialogClose"/>
            </OverflowToolbar>
        </footer>
    </Dialog>
</c:FragmentDefinition>
