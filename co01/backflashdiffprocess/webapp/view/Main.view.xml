<mvc:View
    controllerName="co.backflashdiffprocess.controller.Main"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
>
    <Page
        id="page"
        showHeader="false"
        showFooter="false"
    >
        <content>
            <IconTabBar
                id="idIconTabBar"
                expanded="{device>/isNoPhone}"
                stretchContentHeight="true"
                backgroundDesign="Transparent"
                applyContentPadding="false"
                class="sapUiNoContentPadding"
            >
                <items>
                    <IconTabFilter
                        text="{i18n>tabInventoryDifference}"
                        key="inventoryDifference"
                    >
                        <mvc:XMLView
                            viewName="co.backflashdiffprocess.view.InventoryDifference"
                            height="100%"
                        />
                    </IconTabFilter>
                    <IconTabFilter
                        text="{i18n>tabAllocationResult}"
                        key="allocationResult"
                    >
                        <mvc:XMLView
                            viewName="co.backflashdiffprocess.view.AllocationResult"
                            height="100%"
                        />
                    </IconTabFilter>
                    <IconTabFilter
                        text="{i18n>tabProcessLog}"
                        key="processLog"
                    >
                        <mvc:XMLView
                            viewName="co.backflashdiffprocess.view.ProcessLog"
                            height="100%"
                        />
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
