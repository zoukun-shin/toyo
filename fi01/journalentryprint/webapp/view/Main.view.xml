<mvc:View
    controllerName="fi.journalentryprint.controller.Main"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage
        id="idDynamicPage"
        fitContent="true"
    >
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSmartVariantManagement"
                        showShare="true"
                        persistencyKey="journalEntryPrintVariant"
                        showExecuteOnSelection="true"
                        entitySet="JournalEntryPrint"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSmartFilterBar"
                        smartVariant="idSmartVariantManagement"
                        persistencyKey="journalEntryPrintFilter"
                        entitySet="JournalEntryPrint"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="CompanyCode"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/CompanyCode/@sap:label}"
                                index="5"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="Ledger"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/Ledger/@sap:label}"
                                index="10"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="FiscalYear"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/FiscalYear/@sap:label}"
                                index="15"
                                filterType="single"
                                mandatory="mandatory"
                            >
                                <smartFilterBar:customControl>
                                    <DatePicker
                                        id="idFiscalYear"
                                        displayFormat="yyyy"
                                        valueFormat="yyyy"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="FiscalPeriod"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/FiscalPeriod/@sap:label}"
                                index="20"
                                filterType="single"
                            >
                                <smartFilterBar:customControl>
                                    <Select
                                        id="idFiscalPeriod"
                                        forceSelection="false"
                                    >
                                        <core:Item id="idPeriodBlank" key="" text="" />
                                            <core:Item id="idPeriod01" key="001" text="01" />
                                            <core:Item id="idPeriod02" key="002" text="02" />
                                            <core:Item id="idPeriod03" key="003" text="03" />
                                            <core:Item id="idPeriod04" key="004" text="04" />
                                            <core:Item id="idPeriod05" key="005" text="05" />
                                            <core:Item id="idPeriod06" key="006" text="06" />
                                            <core:Item id="idPeriod07" key="007" text="07" />
                                            <core:Item id="idPeriod08" key="008" text="08" />
                                            <core:Item id="idPeriod09" key="009" text="09" />
                                            <core:Item id="idPeriod10" key="010" text="10" />
                                            <core:Item id="idPeriod11" key="011" text="11" />
                                            <core:Item id="idPeriod12" key="012" text="12" />
                                            <core:Item id="idPeriod13" key="013" text="13" />
                                            <core:Item id="idPeriod14" key="014" text="14" />
                                            <core:Item id="idPeriod15" key="015" text="15" />
                                            <core:Item id="idPeriod16" key="016" text="16" />
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="DocumentDate"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/DocumentDate/@sap:label}"
                                index="25"
                                filterType="interval"
                                mandatory="notMandatory"
                            >
                                <smartFilterBar:customControl>
                                    <DateRangeSelection
                                        id="idDRDocumentDate"
                                        valueFormat="yyyy/MM/dd"
                                        displayFormat="yyyy/MM/dd"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="PostingDate"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/PostingDate/@sap:label}"
                                index="30"
                                filterType="interval"
                                mandatory="notMandatory"
                            >
                                <smartFilterBar:customControl>
                                    <DateRangeSelection
                                        id="idDRPostingDate"
                                        valueFormat="yyyy/MM/dd"
                                        displayFormat="yyyy/MM/dd"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="AccountingDocument"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/AccountingDocument/@sap:label}"
                                index="35"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="GLAccount"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/GLAccount/@sap:label}"
                                index="40"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="AccountingDocumentType"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/AccountingDocumentType/@sap:label}"
                                index="45"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="AccountingDocumentCategory"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/AccountingDocumentCategory/@sap:label}"
                                index="50"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="AccountingDocCreatedByUser"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/AccountingDocCreatedByUser/@sap:label}"
                                index="55"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="PrintStatus"
                                visibleInAdvancedArea="true"
                                label="{/#JournalEntryPrintType/PrintStatus/@sap:label}"
                                index="60"
                                filterType="single"
                            >
                                <smartFilterBar:customControl>
                                    <Select
                                        id="idPrintStatus"
                                        forceSelection="false"
                                    >
                                        <core:Item id="idPrintStatusAll" key="" text="" />
                                        <core:Item id="idPrintStatusPrinted" key="1" text="{i18n>printed}" />
                                        <core:Item id="idPrintStatusUnprinted" key="2" text="{i18n>unprinted}" />
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <!-- 以下は検索条件に出さない項目（一覧表示用・算出値） -->
                            <smartFilterBar:ControlConfiguration
                                key="PrintCount"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="TitleType"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="TitleText"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="CompanyCodeName"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="AccountingDocumentTypeName"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="AmountInCompanyCodeCurrency"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="CompanyCodeCurrency"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="IsReversed"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="ReverseDocument"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="ReversedOriginalDocument"
                                visible="false"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="CreatedByUserName"
                                visible="false"
                            />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox
                id="idContentBox"
                height="100%"
                renderType="Bare"
            >
                <IconTabBar
                    id="idTitleTabBar"
                    selectedKey="1"
                    select="onTabSelect"
                    expandable="false"
                    applyContentPadding="false"
                    headerMode="Inline"
                >
                    <items>
                        <IconTabFilter
                            id="idTabPayable"
                            key="1"
                            text="{i18n>tabPayable}"
                        />
                        <IconTabFilter
                            id="idTabPayment"
                            key="2"
                            text="{i18n>tabPayment}"
                        />
                        <IconTabFilter
                            id="idTabOther"
                            key="3"
                            text="{i18n>tabOther}"
                        />
                    </items>
                </IconTabBar>
                <smartTable:SmartTable
                    id="idSmartTable"
                    entitySet="JournalEntryPrint"
                    smartFilterId="idSmartFilterBar"
                    smartVariant="idSmartVariantManagement"
                    persistencyKey="journalEntryPrintTable"
                    header="{i18n>tableHeaderTitle}"
                    placeToolbarInTable="true"
                    beforeRebindTable="onBeforeRebindTable"
                    beforeExport="onBeforeExport"
                    requestAtLeastFields="CompanyCode,FiscalYear,Ledger,AccountingDocument,CompanyCodeCurrency,PrintStatus,AccountingDocCreatedByUser,AccountingDocumentTypeName"
                    showRowCount="true"
                    useExportToExcel="true"
                >
                    <smartTable:layoutData>
                        <FlexItemData
                            id="idSmartTableLayout"
                            growFactor="1"
                            baseSize="0%"
                        />
                    </smartTable:layoutData>
                    <smartTable:customToolbar>
                        <OverflowToolbar id="idOverflowToolbar">
                            <ToolbarSpacer id="idToolbarSpacer" />
                            <Button
                                id="idPrintButton"
                                text="{i18n>print}"
                                type="Emphasized"
                                press="onPrint"
                            />
                        </OverflowToolbar>
                    </smartTable:customToolbar>
                    <t:Table
                        id="idJournalEntryTable"
                        selectionMode="MultiToggle"
                        class="sapUiSizeCompact"
                    >
                        <t:rowMode>
                            <!-- 固定行内容高度：屏幕缩放150%时 Auto 模式行高测量出小数，底部会留白（同 SD-056 zicprice） -->
                            <rm:Auto
                                id="idAuto"
                                rowContentHeight="32"
                            />
                        </t:rowMode>
                        <t:columns>
                            <t:Column
                                id="idColPrintStatus"
                                width="7rem"
                                label="{/#JournalEntryPrintType/PrintStatus/@sap:label}"
                                sortProperty="PrintStatus"
                                filterProperty="PrintStatus"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"PrintStatus", "leadingProperty":"PrintStatus", "sortProperty":"PrintStatus", "filterProperty":"PrintStatus"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <ObjectStatus
                                        text="{= ${PrintStatus} === '1' ? ${i18n>printed} : ${i18n>unprinted} }"
                                        state="{= ${PrintStatus} === '1' ? 'Success' : 'None' }"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColCompanyCode"
                                width="6rem"
                                label="{/#JournalEntryPrintType/CompanyCode/@sap:label}"
                                sortProperty="CompanyCode"
                                filterProperty="CompanyCode"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"CompanyCode", "leadingProperty":"CompanyCode", "sortProperty":"CompanyCode", "filterProperty":"CompanyCode"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{CompanyCode}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColFiscalYear"
                                width="6rem"
                                label="{/#JournalEntryPrintType/FiscalYear/@sap:label}"
                                sortProperty="FiscalYear"
                                filterProperty="FiscalYear"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"FiscalYear", "leadingProperty":"FiscalYear", "sortProperty":"FiscalYear", "filterProperty":"FiscalYear"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{FiscalYear}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColAccountingDocument"
                                width="8rem"
                                label="{/#JournalEntryPrintType/AccountingDocument/@sap:label}"
                                sortProperty="AccountingDocument"
                                filterProperty="AccountingDocument"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"AccountingDocument", "leadingProperty":"AccountingDocument", "sortProperty":"AccountingDocument", "filterProperty":"AccountingDocument"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Link
                                        text="{AccountingDocument}"
                                        press="onDocumentPress"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColDocumentType"
                                width="12rem"
                                label="{/#JournalEntryPrintType/AccountingDocumentType/@sap:label}"
                                sortProperty="AccountingDocumentType"
                                filterProperty="AccountingDocumentType"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"AccountingDocumentType", "leadingProperty":"AccountingDocumentType", "additionalProperty":"AccountingDocumentTypeName", "sortProperty":"AccountingDocumentType", "filterProperty":"AccountingDocumentType"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{AccountingDocumentType} {AccountingDocumentTypeName}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColDocumentDate"
                                width="7rem"
                                label="{/#JournalEntryPrintType/DocumentDate/@sap:label}"
                                sortProperty="DocumentDate"
                                filterProperty="DocumentDate"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"DocumentDate", "leadingProperty":"DocumentDate", "sortProperty":"DocumentDate", "filterProperty":"DocumentDate", "type":"date"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text text="{path:'DocumentDate', type:'sap.ui.model.type.Date', formatOptions: {UTC: true}}" />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColPostingDate"
                                width="7rem"
                                label="{/#JournalEntryPrintType/PostingDate/@sap:label}"
                                sortProperty="PostingDate"
                                filterProperty="PostingDate"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"PostingDate", "leadingProperty":"PostingDate", "sortProperty":"PostingDate", "filterProperty":"PostingDate", "type":"date"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text text="{path:'PostingDate', type:'sap.ui.model.type.Date', formatOptions: {UTC: true}}" />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColHeaderText"
                                width="14rem"
                                label="{/#JournalEntryPrintType/AccountingDocumentHeaderText/@sap:label}"
                                sortProperty="AccountingDocumentHeaderText"
                                filterProperty="AccountingDocumentHeaderText"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"AccountingDocumentHeaderText", "leadingProperty":"AccountingDocumentHeaderText", "sortProperty":"AccountingDocumentHeaderText", "filterProperty":"AccountingDocumentHeaderText"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{AccountingDocumentHeaderText}"
                                        tooltip="{AccountingDocumentHeaderText}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColAmount"
                                width="11rem"
                                label="{/#JournalEntryPrintType/AmountInCompanyCodeCurrency/@sap:label}"
                                sortProperty="AmountInCompanyCodeCurrency"
                                filterProperty="AmountInCompanyCodeCurrency"
                                hAlign="Right"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"AmountInCompanyCodeCurrency", "leadingProperty":"AmountInCompanyCodeCurrency", "additionalProperty":"CompanyCodeCurrency", "sortProperty":"AmountInCompanyCodeCurrency", "filterProperty":"AmountInCompanyCodeCurrency"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <ObjectNumber
                                        number="{parts: ['AmountInCompanyCodeCurrency', 'CompanyCodeCurrency'], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
                                        unit="{CompanyCodeCurrency}"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColIsReversed"
                                width="6rem"
                                label="{/#JournalEntryPrintType/IsReversed/@sap:label}"
                                sortProperty="IsReversed"
                                filterProperty="IsReversed"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"IsReversed", "leadingProperty":"IsReversed", "sortProperty":"IsReversed", "filterProperty":"IsReversed"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{= ${IsReversed} ? ${i18n>yes} : ${i18n>no} }"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColReverseDocument"
                                width="9rem"
                                label="{/#JournalEntryPrintType/ReverseDocument/@sap:label}"
                                sortProperty="ReverseDocument"
                                filterProperty="ReverseDocument"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"ReverseDocument", "leadingProperty":"ReverseDocument", "sortProperty":"ReverseDocument", "filterProperty":"ReverseDocument"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{ReverseDocument}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColReversedOriginal"
                                width="8rem"
                                label="{/#JournalEntryPrintType/ReversedOriginalDocument/@sap:label}"
                                sortProperty="ReversedOriginalDocument"
                                filterProperty="ReversedOriginalDocument"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"ReversedOriginalDocument", "leadingProperty":"ReversedOriginalDocument", "sortProperty":"ReversedOriginalDocument", "filterProperty":"ReversedOriginalDocument"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{ReversedOriginalDocument}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                            <t:Column
                                id="idColCreatedBy"
                                width="14rem"
                                label="{/#JournalEntryPrintType/CreatedByUserName/@sap:label}"
                                sortProperty="CreatedByUserName"
                                filterProperty="CreatedByUserName"
                            >
                                <t:customData>
                                    <core:CustomData
                                        key="p13nData"
                                        value='\{"columnKey":"CreatedByUserName", "leadingProperty":"CreatedByUserName", "sortProperty":"CreatedByUserName", "filterProperty":"CreatedByUserName"}'
                                    />
                                </t:customData>
                                <t:template>
                                    <Text
                                        text="{CreatedByUserName}"
                                        tooltip="{CreatedByUserName}"
                                        wrapping="false"
                                    />
                                </t:template>
                            </t:Column>
                        </t:columns>
                    </t:Table>
                </smartTable:SmartTable>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
